# PackLens configuration. Copy to .env (gitignored) and fill in what you need.
# Fixture mode needs nothing below the first block. Never commit real secrets.

# --- Mode -------------------------------------------------------------------
# fixture (default, offline, never calls providers) | live | replay
APP_MODE=fixture
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/packlens.sqlite
LLM_ENABLED=false

# --- Locked P0 baseline (pack-baseline-v1). Other values are rejected. -------
# SOL price used for the $20 check: nansen (P0 baseline, OHLCV closed candles,
# 1 credit per poll) or pyth (Pyth's on-chain SOL/USD price read through
# SOLANA_RPC_HTTP_URL; no key, no credits; use this for 24/7 operation).
PRICE_PROVIDER=nansen
# Nansen candles only: 1m (baseline) or 5m (documented fallback). Ignored for pyth.
PRICE_TIMEFRAME=1m
PRICE_CANDLE_POLICY=closed_only
# The pack rule. 3 wallets and $20 per buy are the spec baseline (pack-baseline-v1).
# Other values run as a labeled custom rule (e.g. 5 and 25 -> pack-custom-5w-25usd-v1)
# in their own live namespace (live:<campaign>:5w-25usd), never mixed with baseline
# packs. The windows below stay locked.
PACK_MIN_TRADE_USD=20
PACK_MIN_WALLETS=3
PACK_WINDOW_SECONDS=20
PACK_EXTENSION_SECONDS=40
PACK_COOLDOWN_SECONDS=120
EVENT_REORDER_TOLERANCE_MS=2000

# --- Pricing, rate, and scheduling ------------------------------------------
# Empty = 30 s for Nansen candles, 5 s for Pyth (a free on-chain read).
PRICE_REFRESH_SECONDS=
PRICE_MAX_AGE_SECONDS=120
PRICE_RESERVE_POLLS=2
NANSEN_MAX_CONCURRENCY=2
# Rate limit only. There is no total-call cap.
NANSEN_MAX_REQUESTS_PER_MINUTE=30
# Reporting target only; never a stop condition.
NANSEN_MIN_SUCCESSFUL_CALLS=100
SMART_MONEY_POLL_SECONDS=120
# Optional: limit the shared Smart Money feed to tokens at most N days old (Nansen
# token_bought_age_days), e.g. 1 for early pump.fun activity. Empty = every token.
SMART_MONEY_FEED_MAX_TOKEN_AGE_DAYS=
# How many new packs base enrichment picks automatically every cycle
# (ordered by wallets, value, recency; never by Smart Money). Operators can
# enrich any other pack from its detail page. With NANSEN_DAILY_CREDIT_CAP, each
# cycle takes only what the paced daily allowance covers; a 60 s cycle gives a
# steady rhythm (about one pack every 7 min at 5,000 credits/day).
ENRICHMENT_AUTO_PACKS_PER_CYCLE=3
ENRICHMENT_CYCLE_SECONDS=300
RAW_CAPTURE_MAX_MB=200
# Optional 0-1 ratio for the CHECK_CONCENTRATION review flag. Empty = facts only.
HOLDER_CONCENTRATION_THRESHOLD=

# --- Live mode (required when APP_MODE=live) --------------------------------
# Backend-only secret; sent only in the `apikey` header to api.nansen.ai.
NANSEN_API_KEY=
# Credit budget for this campaign. No paid request is sent without it.
NANSEN_BUDGET_CREDITS=
# Future ISO UTC time that bounds every Nansen poller and job.
# Tip: `npm run session:set -- 2h` writes this line for you.
# With PRICE_PROVIDER=pyth it is optional: leave it empty and set
# NANSEN_DAILY_CREDIT_CAP for continuous 24/7 sessions, or leave both empty to
# keep Nansen off (packs are still detected; nothing is spent).
NANSEN_SESSION_END_AT=
# Credits allowed per UTC day across all Nansen calls (on top of the campaign
# budget). Resets at 00:00 UTC. Example: 500.
NANSEN_DAILY_CREDIT_CAP=
# Optional; defaults to NANSEN_SESSION_END_AT and cannot be later.
SMART_MONEY_SESSION_END_AT=
SMART_MONEY_ENABLED=true
# The shared global Smart Money feed (5 credits every SMART_MONEY_POLL_SECONDS,
# about 3,600 credits/day). false keeps per-pack Smart Money lookups.
SMART_MONEY_FEED_ENABLED=true
NANSEN_CAMPAIGN_ID=packlens-live
QUOTE_ASSET_ALLOWLIST=SOL
# Any Solana RPC with logsSubscribe. Credential-bearing URLs are redacted in logs.
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Optional fallbacks. A keyed RPC (for example Helius, which meters WebSocket data) can run
# out of credits; after three failed connects the collector moves to the fallback and tries
# the primary again every 30 minutes, and Pyth price reads retry on the fallback.
SOLANA_RPC_HTTP_FALLBACK_URL=
SOLANA_RPC_WS_FALLBACK_URL=
# Operator login secret, at least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# --- Public hosting only ------------------------------------------------------
# Comma-separated origins allowed for cookie-authenticated operator mutations.
ALLOWED_ORIGINS=
# Set true behind HTTPS so the operator cookie is Secure.
SECURE_COOKIES=false
# Public site protections: per-client limits (600 API requests/min, 6 live
# streams, 30 analytics events/min), a 5 s shared read cache, and load
# shedding. Requires SECURE_COOKIES=true.
PUBLIC_HOSTING=false
# Reverse proxy whose X-Forwarded-For is trusted for client addresses:
# "loopback" for a proxy on the same machine (Caddy, nginx), or IPs/CIDRs.
TRUST_PROXY=
